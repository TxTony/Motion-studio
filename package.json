{
  "name": "motion-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/prepare-assets.mjs",
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "check": "npm run architecture:check && npm run lint && npm run format:check && npm test && npm run build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint src tests scripts vite.config.ts eslint.config.mjs",
    "architecture:check": "node scripts/check-architecture.mjs",
    "format": "prettier --write src tests scripts documentation .agents AGENTS.md vite.config.ts eslint.config.mjs",
    "format:check": "prettier --check src tests scripts documentation .agents AGENTS.md vite.config.ts eslint.config.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.32",
    "three": "0.183.2",
    "vue": "3.5.46"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/three": "0.183.1",
    "@vitejs/plugin-vue": "6.0.11",
    "@vue/test-utils": "2.4.11",
    "eslint": "9.39.5",
    "eslint-plugin-vue": "10.12.1",
    "globals": "16.5.0",
    "jsdom": "26.1.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "vite": "7.3.8",
    "vitest": "4.1.12",
    "vue-eslint-parser": "10.4.2",
    "vue-tsc": "3.3.14"
  },
  "overrides": {
    "@vue/test-utils": {
      "js-beautify": "1.14.8"
    }
  }
}
